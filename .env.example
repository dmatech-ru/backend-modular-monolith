# Скопируйте в .env — Makefile подхватит переменные автоматически.
NATS_URL=nats://localhost:4222
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
# APP_ENV=production включает JSON-логи
APP_ENV=development

GATEWAY_CONFIG_PATH=configs/gateway.yaml
IDENTITY_CONFIG_PATH=configs/identity.yaml
CAPTCHA_CONFIG_PATH=configs/captcha.yaml
NOTIFICATIONS_CONFIG_PATH=configs/notifications.yaml

# Переопределяет postgresUrl из configs/identity.yaml, если задан.
# IDENTITY_POSTGRES_URL=postgres://identity:identity@localhost:5432/identity?sslmode=disable

# Переопределяет antiEnumerationKey из configs/identity.yaml. Для реального
# деплоя сгенерировать свой (openssl rand -hex 32) и задать здесь, а не в
# YAML — и держать одинаковым на всех репликах.
# IDENTITY_ANTI_ENUM_KEY=

# Переопределяет authJwtSecret из configs/identity.yaml и configs/gateway.yaml
# (оба читают одну и ту же переменную — без префикса модуля намеренно, см.
# README, раздел "Авторизация"). Для реального деплоя сгенерировать свой
# (openssl rand -hex 32) и задать здесь, а не в YAML — и держать одинаковым
# в identity и gateway.
# AUTH_JWT_SECRET=
